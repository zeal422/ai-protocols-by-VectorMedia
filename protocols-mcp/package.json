{
  "name": "@ai-protocols/mcp-server",
  "version": "2.3.2",
  "description": "MCP server for ai-protocols - exposes protocols, configs, and examples",
  "type": "module",
  "bin": {
    "ai-protocols-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"try { require('fs').chmodSync('build/index.js', '755'); } catch(e) { require('fs').chmodSync('build/index.js', '0o755'); }\"",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "validate": "npm run type-check && npm run lint && npm test"
  },
  "keywords": [
    "mcp",
    "ai",
    "protocols",
    "development",
    "cursor",
    "claude"
  ],
  "author": "VectorMedia",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "js-yaml": "^4.1.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.5.0",
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "@vitest/ui": "^2.0.0",
    "eslint": "^9.5.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
